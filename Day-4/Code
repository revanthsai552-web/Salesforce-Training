## placementHome.js

```javascript
import { LightningElement } from 'lwc';

export default class PlacementHome extends LightningElement {

    studentName = 'Revanth Sai';
    rollNumber = '24PA5A5704';
    department = 'CSBS';

    todayDate = new Date().toLocaleDateString();

    companyCount = 25;
    jobCount = 63;
    applicationCount = 5;

    isVisible = false;
    status = 'Not Applied';

    showMessage() {
        this.isVisible = true;
    }

    applyJob() {
        this.status = 'Applied';
    }
}
```

